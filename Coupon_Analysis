  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Target Variable Analysis\n",
    "\n",
    "Let's analyze the distribution of coupon acceptance (our target variable Y)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Target variable distribution\n",
    "print(\"Coupon Acceptance Rate:\")\n",
    "print(\"=\"*60)\n",
    "acceptance_counts = df['Y'].value_counts()\n",
    "acceptance_pct = df['Y'].value_counts(normalize=True) * 100\n",
    "\n",
    "acceptance_df = pd.DataFrame({\n",
    "    'Count': acceptance_counts,\n",
    "    'Percentage': acceptance_pct\n",
    "})\n",
    "acceptance_df.index = ['Accepted (Y=1)', 'Rejected (Y=0)']\n",
    "print(acceptance_df)\n",
    "print(f\"\\nOverall Acceptance Rate: {acceptance_pct[1]:.2f}%\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize coupon acceptance\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
