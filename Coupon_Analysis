    "\n",
    "# Add value labels\n",
    "for i, v in enumerate(acceptance_counts):\n",
    "    axes[0].text(i, v + 100, f'{v}\\n({acceptance_pct[i]:.1f}%)', \n",
    "                ha='center', fontweight='bold')\n",
    "\n",
    "# Pie chart\n",
    "colors = ['#e74c3c', '#2ecc71']\n",
