   "source": [
    "## 9. Statistical Summary of Findings\n",
    "\n",
    "Let's create a comprehensive statistical summary."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create summary statistics dataframe\n",
    "summary_stats = pd.DataFrame()\n",
    "\n",
    "# Overall statistics\n",
    "summary_stats['Overall'] = [\n",
    "    f\"{df['Y'].mean() * 100:.2f}%\",\n",
    "    df['Y'].sum(),\n",
    "    len(df) - df['Y'].sum(),\n",
    "    len(df)\n",
    "]\n",
    "\n",
    "# By coupon type\n",
    "for coupon_type in df['coupon'].unique():\n",
    "    coupon_data = df[df['coupon'] == coupon_type]\n",
    "    summary_stats[coupon_type] = [\n",
    "        f\"{coupon_data['Y'].mean() * 100:.2f}%\",\n",
    "        coupon_data['Y'].sum(),\n",
    "        len(coupon_data) - coupon_data['Y'].sum(),\n",
    "        len(coupon_data)\n",
    "    ]\n",
    "\n",
    "summary_stats.index = ['Acceptance Rate', 'Accepted', 'Rejected', 'Total']\n",
    "\n",
    "print(\"\\nSTATISTICAL SUMMARY\")\n",
    "print(\"=\"*80)\n",
    "print(summary_stats)\n",
    "print(\"\\n\" + \"=\"*80)"
   ]
