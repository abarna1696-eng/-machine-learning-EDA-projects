  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Deep Dive: Bar Coupon Analysis\n",
    "\n",
    "Let's perform a detailed analysis of bar coupons specifically."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Filter for bar coupons\n",
    "bar_coupons = df[df['coupon'] == 'Bar'].copy()\n",
    "\n",
    "print(\"\\nBar Coupon Analysis:\")\n",
    "print(\"=\"*60)\n",
    "print(f\"Total bar coupons: {len(bar_coupons)}\")\n",
    "print(f\"Acceptance rate: {(bar_coupons['Y'].mean() * 100):.2f}%\")\n",
    "print(f\"\\nComparison to overall acceptance rate: {(df['Y'].mean() * 100):.2f}%\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Analyze bar visit frequency (if column exists)\n",
    "bar_frequency_cols = [col for col in df.columns if 'Bar' in col and 'bar' in col.lower()]\n",
    "print(f\"\\nBar-related columns: {bar_frequency_cols}\")\n",
    "\n",
    "if bar_frequency_cols:\n",
    "    for col in bar_frequency_cols:\n",
    "        print(f\"\\n{col}:\")\n",
    "        print(bar_coupons[col].value_counts())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Chi-square test: Is bar coupon acceptance independent of age?\n",
    "if 'age' in bar_coupons.columns:\n",
    "    print(\"\\nChi-Square Test: Bar Coupon Acceptance vs Age\")\n",
    "    print(\"=\"*60)\n",
    "    \n",
    "    contingency_table = pd.crosstab(bar_coupons['age'], bar_coupons['Y'])\n",
    "    chi2, p_value, dof, expected = stats.chi2_contingency(contingency_table)\n",
    "    \n",
    "    print(f\"Chi-square statistic: {chi2:.4f}\")\n",
    "    print(f\"P-value: {p_value:.4f}\")\n",
    "    print(f\"Degrees of freedom: {dof}\")\n",
    "    \n",
    "    if p_value < 0.05:\n",
    "        print(\"\\nConclusion: There IS a significant relationship between age and bar coupon acceptance (p < 0.05)\")\n",
    "    else:\n",
    "        print(\"\\nConclusion: There is NO significant relationship between age and bar coupon acceptance (p >= 0.05)\")"
   ]
  },
  {
