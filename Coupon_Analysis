   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Demographic Analysis\n",
    "\n",
    "Let's explore how demographic factors influence coupon acceptance."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define demographic columns\n",
    "demographic_cols = ['gender', 'age', 'maritalStatus', 'has_children', \n",
    "                    'education', 'occupation', 'income']\n",
    "\n",
    "# Check which columns exist\n",
    "available_demographics = [col for col in demographic_cols if col in df.columns]\n",
    "print(f\"Available demographic features: {available_demographics}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Acceptance rate by demographics\n",
    "def plot_acceptance_by_feature(df, feature, title):\n",
    "    \"\"\"Plot acceptance rate by a categorical feature\"\"\"\n",
    "    if feature not in df.columns:\n",
    "        print(f\"Feature '{feature}' not found in dataset\")\n",
    "        return\n",
    "    \n",
    "    # Calculate acceptance rate\n",
    "    acceptance_by_feature = df.groupby(feature)['Y'].agg([\n",
    "        ('Total', 'count'),\n",
    "        ('Accepted', 'sum'),\n",
    "        ('Acceptance_Rate', lambda x: (x.sum() / x.count()) * 100)\n",
    "    ]).sort_values('Acceptance_Rate', ascending=False)\n",
    "    \n",
    "    print(f\"\\n{title}:\")\n",
    "    print(\"=\"*60)\n",
    "    print(acceptance_by_feature)\n",
    "    \n",
    "    return acceptance_by_feature\n",
    "\n",
    "# Analyze each demographic factor\n",
    "for demo in available_demographics[:4]:  # First 4 demographics\n",
    "    result = plot_acceptance_by_feature(df, demo, f\"Acceptance Rate by {demo.title()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize acceptance by age and gender\n",
    "fig, axes = plt.subplots(2, 2, figsize=(16, 12))\n",
    "\n",
    "demo_features = ['age', 'gender', 'maritalStatus', 'income']\n",
    "existing_features = [f for f in demo_features if f in df.columns]\n",
    "\n",
    "for idx, feature in enumerate(existing_features[:4]):\n",
    "    row = idx // 2\n",
    "    col = idx % 2\n",
    "    \n",
    "    # Calculate acceptance rate\n",
    "    acceptance = df.groupby(feature)['Y'].mean() * 100\n",
    "    \n",
    "    # Plot\n",
    "    acceptance.plot(kind='bar', ax=axes[row, col], color='#3498db', edgecolor='black')\n",
    "    axes[row, col].set_title(f'Acceptance Rate by {feature.title()}', \n",
    "                             fontsize=12, fontweight='bold')\n",
    "    axes[row, col].set_xlabel(feature.title(), fontsize=11)\n",
    "    axes[row, col].set_ylabel('Acceptance Rate (%)', fontsize=11)\n",
    "    axes[row, col].tick_params(axis='x', rotation=45)\n",
    "    axes[row, col].grid(axis='y', alpha=0.3)\n",
    "    \n",
    "    # Add percentage labels\n",
    "    for i, v in enumerate(acceptance):\n",
    "        axes[row, col].text(i, v + 1, f'{v:.1f}%', ha='center', fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('images/acceptance_by_demographics.png', dpi=300, bbox_inches='tight')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
