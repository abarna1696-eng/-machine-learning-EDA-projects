    "axes[1].set_xlabel('Acceptance Rate (%)', fontsize=12)\n",
    "axes[1].set_ylabel('Coupon Type', fontsize=12)\n",
    "axes[1].grid(axis='x', alpha=0.3)\n",
    "\n",
    "# Add percentage labels\n",
    "for i, v in enumerate(coupon_acceptance['Acceptance_Rate']):\n",
